---
import { siteConfig } from "../config";
const year = new Date().getFullYear();
---

<footer class="relative py-8 border-t border-violet-100 bg-white/70 backdrop-blur-sm">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs text-ink-soft">
      &copy; {year} {siteConfig.name}
    </p>
    <div></div>
    <!-- Back to top -->
    <a href="#" class="text-xs text-ink-soft hover:text-violet-700 transition-colors" aria-label="Back to top">
      ↑ Top
    </a>
  </div>
</footer>
