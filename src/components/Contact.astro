---
import { siteConfig } from "../config";
---

<section id="contact" class="relative py-28 md:py-36 overflow-hidden">
  <!-- Aurora backdrop -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[720px] h-[720px] rounded-full bg-violet-300 opacity-45 blur-[130px]"></div>
    <div class="absolute left-[15%] top-[25%] w-[420px] h-[420px] rounded-full bg-blue-300 opacity-45 blur-[120px]"></div>
    <div class="absolute right-[12%] bottom-[15%] w-[380px] h-[380px] rounded-full bg-purple-200 opacity-60 blur-[110px]"></div>
  </div>

  <div class="relative max-w-2xl mx-auto px-6 text-center">
    <div class="reveal">
      <p class="text-sm font-mono text-violet-600 mb-2">// contact</p>
      <h2 class="text-3xl md:text-5xl font-bold gradient-text mb-6 leading-tight">Let's make your idea real</h2>
      <p class="text-ink-muted mb-10 leading-relaxed">
        Have a process to automate, a product to build or data you want to put to work? Tell me what you have in mind and I'll help you turn it into a working system.
      </p>

      <!-- Email CTA -->
      <a
        href={`mailto:${siteConfig.social.email}`}
        class="magnetic btn-primary inline-flex items-center gap-2 px-8 py-4 rounded-full font-semibold mb-8"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <span>Get in Touch</span>
      </a>

      <!-- Social row -->
      <div class="flex justify-center gap-4">
        <a href={siteConfig.social.github} target="_blank" rel="noopener" class="p-3 glass rounded-full hover:bg-violet-50 hover:-translate-y-0.5 transition-all duration-200 group" aria-label="GitHub">
          <svg class="w-5 h-5 text-ink-muted group-hover:text-violet-700 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href={siteConfig.social.linkedin} target="_blank" rel="noopener" class="p-3 glass rounded-full hover:bg-violet-50 hover:-translate-y-0.5 transition-all duration-200 group" aria-label="LinkedIn">
          <svg class="w-5 h-5 text-ink-muted group-hover:text-violet-700 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href={`mailto:${siteConfig.social.email}`} class="p-3 glass rounded-full hover:bg-violet-50 hover:-translate-y-0.5 transition-all duration-200 group" aria-label="Email">
          <svg class="w-5 h-5 text-ink-muted group-hover:text-violet-700 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
