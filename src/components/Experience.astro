---
import { siteConfig } from "../config";
import BrandIcon from "./BrandIcon.astro";
import { getIconInfo } from "../utils/icons";
---

<section id="experience" class="relative py-24 md:py-32 bg-lilac/70">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Section header -->
    <div class="reveal mb-16">
      <p class="text-sm font-mono text-violet-600 mb-2">// experience</p>
      <h2 class="text-3xl md:text-4xl font-bold text-ink">Experience</h2>
      <p class="text-ink-muted mt-4 max-w-2xl leading-relaxed">
        Click a role to see the details.
      </p>
      <div class="shimmer-bar w-24 mt-4"></div>
    </div>

    <!-- Timeline -->
    <div class="relative pl-10 md:pl-12 [--tl-pad:2.5rem] md:[--tl-pad:3rem]">
      <!-- Vertical line: track + animated draw -->
      <div class="timeline-track"></div>
      <div id="timeline-line" class="timeline-line"></div>

      {siteConfig.experience.map((exp, i) => {
        const open = i === 0;
        const icon = getIconInfo(exp.company);
        return (
          <div class={`reveal stagger-${Math.min(i + 1, 6)} relative mb-6 last:mb-0`}>
            <!-- Dot -->
            <div class={`timeline-dot ${exp.featured ? 'timeline-dot-featured' : ''}`}></div>

            <!-- Collapsible card -->
            <div
              class={`exp-card glass rounded-2xl spot ring-hover card-3d ${exp.featured ? 'border-l-4 border-l-violet-500' : ''}`}
              data-open={open ? 'true' : 'false'}
            >
              <button
                type="button"
                class="exp-toggle w-full text-left p-5 md:p-6 flex items-start justify-between gap-4 cursor-pointer"
                aria-expanded={open ? 'true' : 'false'}
              >
                <div class="min-w-0">
                  <h3 class="text-lg font-bold text-ink flex items-center gap-2 flex-wrap">
                    {icon.isLogotype ? (
                      /* Logotype (wide text logo like "BBVA") — logo REPLACES text */
                      <BrandIcon name={exp.company} size={24} mono />
                    ) : icon.file ? (
                      /* Isotipo (square icon) — logo + text */
                      <Fragment>
                        <BrandIcon name={exp.company} size={22} mono />
                        {exp.company}
                      </Fragment>
                    ) : (
                      /* No icon — just text */
                      <Fragment>{exp.company}</Fragment>
                    )}
                    {exp.featured && (
                      <span class="px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider rounded-full bg-violet-100 text-violet-700">
                        Current
                      </span>
                    )}
                  </h3>
                  {exp.subtitle && <p class="text-xs text-ink-soft">{exp.subtitle}</p>}
                  <p class="text-sm text-blue-600 font-medium mt-0.5">{exp.title}</p>

                  <!-- Tags stay visible when collapsed -->
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    {exp.tags.map((tag) => (
                      <span class="px-2 py-0.5 text-[10px] font-mono rounded-md bg-blue-50 text-blue-700 border border-blue-100">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="text-right shrink-0 flex flex-col items-end gap-2">
                  <div>
                    <p class="text-xs text-ink-muted font-mono">{exp.dateRange}</p>
                    <p class="text-xs text-ink-soft">{exp.location}</p>
                  </div>
                  <span class="inline-flex items-center gap-1 text-[11px] font-mono text-violet-600">
                    <span class="exp-label">{open ? 'Hide' : 'Details'}</span>
                    <svg class="exp-chevron w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </span>
                </div>
              </button>

              <!-- Expandable body -->
              <div class="exp-body">
                <div>
                  <ul class="space-y-2.5 px-5 md:px-6 pb-5 md:pb-6 border-t border-violet-100 pt-4">
                    {exp.highlights.map((h) => (
                      <li class="text-sm text-ink-muted flex items-start gap-2 leading-relaxed">
                        <span class="text-violet-500 mt-0.5 shrink-0">▹</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
