---
import { siteConfig } from "../config";
import BrandIcon from "./BrandIcon.astro";

const { about } = siteConfig;

// No hardcoded map needed — BrandIcon auto-discovers from public/icons/
const skillCategories = [
  { label: "Software Engineering", items: siteConfig.skills.engineering, color: "text-blue-600" },
  { label: "Cloud", items: siteConfig.skills.cloud, color: "text-violet-600" },
  { label: "AI & ML", items: siteConfig.skills.ai, color: "text-purple-600" },
  { label: "Tools", items: siteConfig.skills.tools, color: "text-sky-600" },
  { label: "Databases", items: siteConfig.skills.databases, color: "text-indigo-600" },
];
---

<section id="about" class="relative py-24 md:py-32 bg-lilac/70">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal mb-16">
      <p class="text-sm font-mono text-violet-600 mb-2">{about.eyebrow}</p>
      <h2 class="text-3xl md:text-5xl font-bold text-ink leading-tight">{about.heading}</h2>
      <div class="shimmer-bar w-24 mt-4"></div>
    </div>

    <!-- Two columns: photo + pitch -->
    <div class="grid md:grid-cols-[minmax(0,420px)_1fr] gap-12 items-start mb-20">
      <div class="reveal stagger-1 flex justify-center md:justify-start">
        <div class="relative mt-6 ml-4">
          <div class="w-72 md:w-96 photo-frame">
            <img
              src="/profile.jpg"
              alt={siteConfig.name}
              class="w-full h-auto"
              loading="lazy"
            />
          </div>

          <!-- Floating chips -->
          <div class="absolute -top-5 -left-6 glass rounded-full px-3.5 py-1.5 text-xs font-mono text-violet-700 animate-float">
            RAG & Agentic AI
          </div>
          <div class="absolute top-1/3 -right-8 glass rounded-full px-3.5 py-1.5 text-xs font-mono text-blue-700 animate-float" style="animation-delay: 1.2s">
            Azure ☁
          </div>
          <div class="absolute -bottom-4 -right-3 glass rounded-full px-4 py-2 text-xs font-mono text-ink animate-float" style="animation-delay: 2.1s">
            Data · AI · Cloud
          </div>
        </div>
      </div>

      <div class="reveal stagger-2 space-y-6">
        <p class="text-ink leading-relaxed text-[17px] font-medium">{about.pitch}</p>
        <p class="text-ink-muted leading-relaxed text-[15px]">{about.proof}</p>

        <!-- Value props -->
        <ul class="grid sm:grid-cols-3 gap-3">
          {about.valueProps.map((vp) => (
            <li class="glass rounded-2xl p-4 spot">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-6 h-6 rounded-lg bg-gradient-to-br from-blue-600 to-violet-600 text-white flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                </span>
                <h3 class="text-sm font-bold text-ink">{vp.title}</h3>
              </div>
              <p class="text-xs text-ink-muted leading-relaxed">{vp.text}</p>
            </li>
          ))}
        </ul>

        <!-- Availability + CTAs -->
        <div class="glass rounded-2xl p-5 border-l-4 border-l-violet-500 spot flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <p class="text-sm text-ink">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-2 align-middle"></span>
            {about.availability}
          </p>
          <div class="flex items-center gap-3 shrink-0">
            <a href="#services" class="px-4 py-2 text-sm font-medium rounded-full glass text-violet-700 hover:bg-violet-50 transition-colors">
              See services
            </a>
            <a href={`mailto:${siteConfig.social.email}`} class="magnetic btn-primary px-4 py-2 text-sm font-semibold rounded-full">
              Get in touch
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Skills grid with icons -->
    <div class="reveal">
      <p class="text-sm font-mono text-violet-600 mb-2">// tech stack</p>
      <h3 class="text-2xl font-bold text-ink mb-8">Tech stack</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {skillCategories.map((cat, i) => (
          <div class={`reveal stagger-${i + 1} glass rounded-2xl p-5 spot ring-hover card-3d`}>
            <h4 class={`text-sm font-mono mb-3 ${cat.color}`}>{cat.label}</h4>
            <div class="flex flex-wrap gap-2">
              {cat.items.map((skill) => (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs rounded-full bg-white text-ink-muted border border-violet-100 hover:border-violet-400 hover:text-violet-700 hover:-translate-y-0.5 hover:shadow-md hover:shadow-violet-500/10 transition-all duration-200">
                  <BrandIcon name={skill} size={12} />
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
